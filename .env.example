# Токен бота из @BotFather
BOT_TOKEN=1234567890:AAExample_ReplaceMe

# ID администраторов через запятую (узнать можно у @userinfobot)
ADMIN_IDS=123456789

# Название сервиса
SUPPORT_NAME=Support

# Путь к базе данных (относительно папки проекта)
DB_PATH=data/support.db

# Через сколько часов без ответа пользователя обращение уходит в архив
ARCHIVE_AFTER_HOURS=48

# Пауза между сообщениями рассылки (секунды)
BROADCAST_DELAY=0.05

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
